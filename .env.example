# Optional Sigma-owned cloud configuration.
#
# Leave every value unset to keep cloud pairing, hosted relay, and remote
# telemetry disabled. Never copy T3 Code production keys or endpoints here.

# SIGMACODE_CLERK_PUBLISHABLE_KEY=pk_test_...
# SIGMACODE_CLERK_JWT_TEMPLATE=sigma-relay
# SIGMACODE_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...
# SIGMACODE_RELAY_URL=https://relay.example.com
# SIGMACODE_HOSTED_APP_URL=https://code.example.com
# SIGMACODE_MOBILE_RELYING_PARTY_DOMAIN=code.example.com
# SIGMACODE_CLERK_GOOGLE_IOS_CLIENT_ID=...
# SIGMACODE_CLERK_GOOGLE_ANDROID_CLIENT_ID=...
# SIGMACODE_CLERK_GOOGLE_WEB_CLIENT_ID=...
# SIGMACODE_CLERK_GOOGLE_WEB_CLIENT_SECRET=...

# Only canonical SIGMACODE_* values are trusted. Direct VITE_*, EXPO_PUBLIC_*,
# and legacy T3CODE_* cloud aliases are ignored by downstream config loading.

# Optional signed macOS builds. These values must belong to Sigma Code.
# SIGMACODE_APPLE_TEAM_ID=ABC1234567
# SIGMACODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/sigmacode.provisionprofile
# SIGMACODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Optional, Sigma-owned observability endpoints.
# SIGMACODE_RELAY_CLIENT_OTLP_TRACES_URL=https://telemetry.example.com/v1/traces
# SIGMACODE_RELAY_CLIENT_OTLP_TRACES_DATASET=sigma-code-relay
# SIGMACODE_RELAY_CLIENT_OTLP_TRACES_TOKEN=...
